# Copy to .env.local if you need to override defaults. No secrets are required for v1.

# Where the SQLite database lives (relative to the repo root). Gitignored.
DATABASE_PATH=data/crm.db

# Optional: a local, gitignored JSON file of identity terms to redact from shared exports
# (e.g. the owner's name, personal email/phone, profile URL, current employer).
# See config/identity.example.json for the shape. Never commit the real file.
IDENTITY_FILE=data/identity.local.json
