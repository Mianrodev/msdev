# Copy to .env.local for local overrides. Never commit real values.

# --- Online (Vercel) ---------------------------------------------------------
# Set automatically when you connect a Neon database in Vercel → Storage.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Optional. Normally you create your password in the app on first visit.
# Setting APP_PASSWORD here overrides that.
# APP_PASSWORD=

# Optional: fixed signing key for login cookies (otherwise one is generated and stored in the database).
# AUTH_SECRET=

# --- Local (your computer) ---------------------------------------------------
# With no DATABASE_URL, an embedded Postgres stores data in this folder (gitignored).
# PGLITE_DIR=data/pglite

# Optional: local, gitignored JSON file of identity terms to redact from shared exports.
# See config/identity.example.json for the shape.
# IDENTITY_FILE=data/identity.local.json

# --- Opportunity workspace (/opportunities) ----------------------------------
# Brand for this deployment: default | meridian | fieldstone (see src/brand/brands.ts).
# BRAND=default

# Live UK tenders from Find a Tender (keyless, Open Government Licence). On unless set to "off".
# OPP_LIVE_FIND_A_TENDER=on

# Optional AI summaries (Anthropic API — billed separately from any Claude subscription).
# Off unless BOTH are set. Summaries run only when a user asks, one record at a time.
# OPP_AI_ENRICHMENT=on
# ANTHROPIC_API_KEY=
# OPP_AI_MODEL=claude-opus-5-5

# Usage limits per workspace (defaults shown).
# OPP_SEARCHES_PER_MINUTE=20
# OPP_LIVE_SEARCHES_PER_DAY=100
# OPP_AI_SUMMARIES_PER_DAY=25
