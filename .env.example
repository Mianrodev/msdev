# Copy to .env.local for local development. Never commit real values.

# --- Required -----------------------------------------------------------------
# The owner account. To reset the owner's password, change OWNER_PASSWORD and redeploy/restart
# (that also signs the owner out everywhere). There is no first-visit setup and no recovery code.
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-me-to-12-plus-characters

# --- Hosting (Vercel) ---------------------------------------------------------
# Set automatically when you connect a Neon database in Vercel → Storage.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Signing key for login cookies (otherwise one is generated and stored in the database).
# AUTH_SECRET=

# --- Local ---------------------------------------------------------------------
# With no DATABASE_URL, an embedded Postgres stores data in this folder (gitignored).
# PGLITE_DIR=data/pglite

# --- Branding ------------------------------------------------------------------
# default | meridian | fieldstone (see src/brand/brands.ts).
# BRAND=default

# --- Live tenders (Find a Tender, keyless, Open Government Licence) ---------------
# On unless set to "off". Each search reads this many days of updates (1-14) and pages of 100 (1-50).
# OPP_LIVE_FIND_A_TENDER=on
# OPP_FTS_LOOKBACK_DAYS=3
# OPP_FTS_MAX_PAGES=20

# --- Optional AI summaries (Anthropic API — billed per use, separate from any Claude subscription) ---
# Off unless BOTH are set. Summaries run only when a user asks, one record at a time.
# OPP_AI_ENRICHMENT=on
# ANTHROPIC_API_KEY=
# OPP_AI_MODEL=claude-opus-5-5
# Output cap per summary, including the model's thinking (1000-16000).
# OPP_AI_MAX_TOKENS=4000
# Automatic fallback to another model when the main one declines. Off unless set:
# "default" (Anthropic chooses) or a comma-separated list of model ids.
# OPP_AI_FALLBACKS=

# --- Usage limits per workspace (defaults shown) ----------------------------------
# OPP_SEARCHES_PER_MINUTE=20
# OPP_LIVE_SEARCHES_PER_DAY=100
# OPP_AI_SUMMARIES_PER_DAY=25
