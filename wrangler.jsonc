{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opportunity-desk",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  // global_fetch_strictly_public: outbound fetch() can never reach private or internal addresses.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opportunity-desk",
      "database_id": "c0bb3bbd-5c2c-4b49-9f4c-46c69a154b19",
      "migrations_dir": "drizzle"
    }
  ],
  // Keep variables set in the dashboard (e.g. BRAND) when deploying. Secrets are always kept.
  "keep_vars": true,
  "observability": { "enabled": true }
}
