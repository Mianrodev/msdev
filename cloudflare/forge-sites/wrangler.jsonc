{
  // Forge Demo public websites — a small Worker that fits the Workers Free plan.
  // Deploy:  npx wrangler deploy -c cloudflare/forge-sites/wrangler.jsonc
  // Secret:  npx wrangler secret put DATABASE_URL -c cloudflare/forge-sites/wrangler.jsonc
  //          (the same Neon connection string the CRM uses)
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "forge-sites",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true }
}
